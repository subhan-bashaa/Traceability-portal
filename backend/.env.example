PORT=5000

# ==============================================================================
# NeonDB Serverless PostgreSQL Connection String
# Get this from your Neon Console: https://console.neon.tech
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# ==============================================================================
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

FRONTEND_URL=http://localhost:5173

# AI Configuration (Gemini Primary, Groq Fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

AI_PRIMARY_PROVIDER=gemini
AI_SECONDARY_PROVIDER=groq

AI_CACHE_TTL=3600

# Redis URL (Optional - in-memory cache used automatically if empty)
REDIS_URL=
